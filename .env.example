# ==============================================================================
# Talvyn Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Database Configuration
# ------------------------------------------------------------------------------
PORT=3001
CLIENT_URL="http://localhost:5173"
DATABASE_URL="file:./prisma/talvyn.db"

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="talvyn-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="talvyn-super-secret-refresh-key-change-in-production"

# ------------------------------------------------------------------------------
# 3. Google OAuth Configuration
#
# NOTE: Both Frontend and Backend use the SAME Google OAuth Web Client ID.
# Obtain your Client ID from Google Cloud Console (see GOOGLE_AUTH_SETUP.md).
# ------------------------------------------------------------------------------

# Frontend Google OAuth Client ID (Exposed to browser by Vite)
VITE_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
VITE_API_URL="http://localhost:3001"

# Backend Google Token Verification
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""
GOOGLE_ALLOWED_ORIGIN="http://localhost:5173"
