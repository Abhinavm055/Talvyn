# ==============================================================================
# Talvyn Environment Configuration Template (.env.example)
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production:
#   - Backend variables -> Configure in Render Dashboard (Environment tab)
#   - Frontend variables -> Configure in Vercel Project Settings (Environment Variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND CONFIGURATION (Render)
# ------------------------------------------------------------------------------

# Port the backend server binds to (Render sets process.env.PORT automatically)
PORT=3001

# Production Neon PostgreSQL Connection String (from Neon Console)
# Format: postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/talvyn?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/talvyn?sslmode=require"

# Production Frontend URL(s) for CORS and Redirects (comma-separated if multiple)
CLIENT_URL="https://your-talvyn-app.vercel.app"

# Exact real store/development extension IDs (32 lowercase letters a-p).
# Leave empty until an ID is obtained from the browser/store dashboard.
# The backend refuses new extension connections when no trusted ID is configured.
TALVYN_EXTENSION_IDS=""

# JWT Authentication Secrets (Generate strong 64+ char random strings for production)
# Keep these values distinct. JWT_REFRESH_SECRET signs rotating extension refresh tokens.
JWT_SECRET="your-production-jwt-secret-key-change-this"
JWT_REFRESH_SECRET="your-production-jwt-refresh-secret-key-change-this"

# Google OAuth Backend Verification (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_ALLOWED_ORIGIN="https://your-talvyn-app.vercel.app"

# Node Environment
NODE_ENV="production"

# Optional LOCAL TESTING only: disposable migrated PostgreSQL database.
# npm test never uses DATABASE_URL for persistence tests.
# TALVYN_TEST_DATABASE_URL="postgresql://test_user:test_password@localhost:5432/talvyn_test"


# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel)
# ------------------------------------------------------------------------------

# Render Backend API Base URL (Exposed to browser by Vite)
# Example: https://your-talvyn-api.onrender.com
# Website API uses a same-origin proxy; direct cross-site cookie calls are unsupported.
VITE_API_URL="/api"

# GitHub repository owner/name for releases (defaults to package.json repository)
TALVYN_GITHUB_REPOSITORY="Abhinavm055/Talvyn"

# Canonical base64 DER/SPKI PUBLIC key for deterministic extension ID derivation.
# Never place a private signing key in environment values or bundles.
# When provided, production manifest and website extension ID are derived automatically.
TALVYN_EXTENSION_PUBLIC_KEY=""

# Optional development public key or extension ID override for local development.
TALVYN_DEV_EXTENSION_PUBLIC_KEY=""
TALVYN_DEV_EXTENSION_IDS=""
VITE_TALVYN_EXTENSION_ID=""

# Frontend Google OAuth Client ID (Must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
