{
  "name": "talvyn",
  "version": "1.0.0",
  "private": true,
  "description": "Talvyn – From Potential to Offer. Universal job application and career management platform.",
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:extension": "npm run dev --prefix extension",
    "build": "npm run build:server && npm run build:web",
    "build:web": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:extension": "npm run build --prefix extension",
    "package:extension": "npm run build:extension && tsx scripts/package-extension.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "preview": "vite preview",
    "test:scoring": "tsx extension/test/verify-scoring.ts",
    "test:autofill": "tsx extension/test/verify-autofill.ts",
    "test:success": "tsx extension/test/verify-success-detection.ts",
    "test:opportunity": "tsx extension/test/verify-opportunity-timeline.ts",
    "test:hardening": "tsx extension/test/verify-hardening.ts",
    "test:google-auth": "tsx test/verify-google-auth.ts",
    "test:onboarding": "tsx test/verify-onboarding-taginput.ts",
    "test:smart-inputs": "tsx test/verify-smart-inputs.ts",
    "test:application-assistant": "tsx extension/test/verify-application-assistant.ts",
    "test:profile-resumes": "tsx test/verify-profile-resume-storage.ts",
    "test:extension-connection": "tsx test/verify-extension-connection.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.62.7",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
