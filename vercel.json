{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/downloads/(.*)",
      "dest": "/downloads/$1",
      "headers": {
        "Content-Type": "application/zip",
        "Content-Disposition": "attachment; filename=\"talvyn-v1.zip\"",
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/logotalvyn.png",
      "dest": "/logotalvyn.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
