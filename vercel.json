{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://talvyn-backend-7ucf.onrender.com/api/$1",
      "headers": { "Cache-Control": "private, no-store" }
    },
    {
      "src": "/extension-release.json",
      "dest": "/extension-release.json",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/favicon.svg",
      "dest": "/favicon.svg"
    },
    {
      "src": "/logo-talvyn.svg",
      "dest": "/logo-talvyn.svg"
    },
    {
      "src": "/logo-talvyn.png",
      "dest": "/logo-talvyn.png"
    },
    {
      "src": "/logotalvyn.png",
      "dest": "/logotalvyn.png"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ]
}
